#!/usr/bin/env groovy
/* groovylint-disable CompileStatic, UnnecessaryGetter */
// Scripted pipeline. Runs Playwright directly on the Jenkins controller
// (the controller image ships Node 20 + Playwright system deps). No
// docker.inside / DinD: with named-volume jenkins_home, host bind-mounts
// of the workspace are impossible and were the source of empty-workspace
// "directory not found" failures during the run stages.
//
// Required Jenkins job config:
//   SCM: https://github.com/AbhisekPhantasm/Phantasm-All.git
//   Branch: master (or your default)
//   Script Path: qa-automation-hub/Jenkinsfile
// (SCM must be the whole Phantasm-All repo so sibling project dirs exist;
//  qa-automation-hub-only checkout will fail registry validation.)

def hubDir() {
  if (fileExists('qa-automation-hub/package.json')) { return 'qa-automation-hub' }
  if (fileExists('package.json') && fileExists('tooling/projects.registry.json')) { return '.' }
  error('Cannot locate qa-automation-hub: expected qa-automation-hub/ at workspace root, or run inside the hub itself.')
}

def fallbackProjectIds() {
  return [
    'example-acme-ui',
    'amipro-simpor-b2c',
    'elitekem',
    'flavor-boys',
    'krc-collage',
    'no-limits-distributions',
    'phantasm-portfolio',
    'sabeeltv',
    'sacred-journey',
    'ushodaya',
  ]
}

def projectIdChoices(String hub) {
  try {
    def regPath = hub == '.' ? 'tooling/projects.registry.json' : "${hub}/tooling/projects.registry.json"
    if (fileExists(regPath)) {
      def reg = readJSON(file: regPath)
      def ids = reg.projects.collect { it.id as String }
      if (ids) { return ids }
    }
  } catch (err) {
    echo "WARN: could not read registry for parameter choices: ${err}"
  }
  return fallbackProjectIds()
}

node {
  stage('Checkout') {
    checkout scm
  }

  def hub = hubDir()
  env.HUB_DIR = hub
  env.PHANTASM_MONO_ROOT = pwd()

  // Refresh parameter definitions from the registry. Takes effect from the
  // NEXT build (Jenkins quirk); the current build uses whatever parameters
  // were registered previously, or the static fallback on first run.
  def ids = projectIdChoices(hub)
  properties([
    parameters([
      choice(name: 'PROJECT_ID', choices: ids.join('\n'),
             description: 'Must exist in tooling/projects.registry.json'),
      choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'].join('\n')),
      choice(name: 'BROWSER', choices: ['chromium', 'firefox', 'webkit'].join('\n')),
      string(name: 'TAGS', defaultValue: '', trim: true,
             description: 'Optional Playwright --grep pattern'),
      booleanParam(name: 'HEADED', defaultValue: false,
                   description: 'Run with a head (X server / Xvfb required)'),
      string(name: 'PW_WORKERS', defaultValue: '4', trim: true),
      string(name: 'SHARD_INDEX', defaultValue: '', trim: true),
      string(name: 'SHARD_TOTAL', defaultValue: '', trim: true),
    ]),
  ])

  // Defaults so the first build (where params.PROJECT_ID may be null) still runs.
  def projectId  = (params.PROJECT_ID ?: ids[0]) as String
  def environ    = (params.ENVIRONMENT ?: 'dev') as String
  def browserId  = (params.BROWSER ?: 'chromium') as String
  def tags       = (params.TAGS ?: '') as String
  def pwWorkers  = (params.PW_WORKERS ?: '4') as String
  def shardIdx   = (params.SHARD_INDEX ?: '') as String
  def shardTotal = (params.SHARD_TOTAL ?: '') as String
  def headed     = params.HEADED ? '1' : '0'

  echo "Resolved parameters: PROJECT_ID=${projectId} ENVIRONMENT=${environ} BROWSER=${browserId} HEADED=${headed}"

  def testRc = null
  Throwable pipelineError = null

  try {
    dir(hub) {
      stage('Validate registry') {
        sh """#!/usr/bin/env bash
set -euo pipefail
export PHANTASM_MONO_ROOT="${env.PHANTASM_MONO_ROOT}"
node tooling/validate-registry.mjs
"""
      }

      if (headed == '1') {
        stage('Start virtual display') {
          sh 'bash scripts/start-display.sh'
          echo 'Watch the browser at: http://localhost:6080/vnc.html'
        }
      }

      stage('Run Playwright') {
        def displayExport = headed == '1' ? 'export DISPLAY=":99"' : '# headless run'
        testRc = sh(returnStatus: true, script: """#!/usr/bin/env bash
set -euo pipefail
${displayExport}
export PHANTASM_MONO_ROOT="${env.PHANTASM_MONO_ROOT}"
export PROJECT_ID="${projectId}"
export ENVIRONMENT="${environ}"
export BROWSER="${browserId}"
export TAGS="${tags}"
export PW_WORKERS="${pwWorkers}"
export SHARD_INDEX="${shardIdx}"
export SHARD_TOTAL="${shardTotal}"
export HEADED="${headed}"
bash scripts/run-project.sh
""")
      }
    }
  } catch (Throwable t) {
    pipelineError = t
  } finally {
    if (headed == '1') {
      dir(hub) {
        stage('Stop virtual display') {
          sh 'bash scripts/stop-display.sh || true'
        }
      }
    }

    dir(hub) {
      stage('Collect artifacts') {
        sh """#!/usr/bin/env bash
set -euo pipefail
export PROJECT_ID="${projectId}"
export BUILD_TAG="${env.BUILD_TAG}"
bash scripts/collect-artifacts.sh || echo "collect-artifacts: non-fatal failure"
"""
      }

      stage('Publish Allure') {
        if (fileExists('qa-hub-last-run.env')) {
          def props = readProperties file: 'qa-hub-last-run.env'
          env.LAST_PROJECT_PATH = props.PROJECT_PATH
          if (env.LAST_PROJECT_PATH?.trim()) {
            try {
              allure([
                includeProperties: false,
                jdk: '',
                properties: [],
                reportBuildPolicy: 'ALWAYS',
                results: [[path: "${env.LAST_PROJECT_PATH}/allure-results"]],
              ])
            } catch (err) {
              // Allure plugin needs the "Allure Commandline" tool configured
              // under Manage Jenkins > Tools. Without it this step throws.
              echo "Allure publish skipped: ${err.message ?: err}"
            }
          }
        } else {
          echo 'No qa-hub-last-run.env; skipping Allure.'
        }
      }

      stage('Archive') {
        archiveArtifacts(
          artifacts: 'artifacts/**,qa-hub-last-run.env',
          fingerprint: true,
          allowEmptyArchive: true,
        )
      }
    }

    if (env.SLACK_WEBHOOK_URL?.trim()) {
      dir(hub) {
        def msg
        if (testRc == null) {
          msg = "[X] ${env.JOB_NAME} #${env.BUILD_NUMBER} FAILED before Playwright (${projectId})"
        } else if (testRc == 0) {
          msg = "[OK] ${env.JOB_NAME} #${env.BUILD_NUMBER} SUCCESS (${projectId})"
        } else {
          msg = "[X] ${env.JOB_NAME} #${env.BUILD_NUMBER} FAILED rc=${testRc} (${projectId})"
        }
        try {
          withEnv(["MESSAGE=${msg}"]) {
            sh '''#!/usr/bin/env bash
set -euo pipefail
bash scripts/notify-slack.sh
'''
          }
        } catch (err) {
          echo "Slack notify skipped: ${err.message ?: err}"
        }
      }
    }

    if (testRc != null && testRc != 0) {
      currentBuild.result = 'FAILURE'
      error("Playwright exited with code ${testRc}")
    }
    if (pipelineError != null) {
      currentBuild.result = 'FAILURE'
      throw pipelineError
    }
  }
}
