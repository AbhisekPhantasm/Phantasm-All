# Copy to `.env` locally (never commit secrets). Jenkins should use Credentials + job parameters.

# Targeting
TEST_ENV=dev
BASE_URL=https://example.dev

# Execution
BROWSER=chromium
HEADED=0
PW_WORKERS=4

# Filtering
# TAGS=@smoke

# Sharding (Playwright uses 1-based shard index)
# SHARD_INDEX=1
# SHARD_TOTAL=3

# Observability
LOG_LEVEL=info

# Integrations (prefer Jenkins credentials in CI)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# QA_EMAIL_RECIPIENTS=qa-team@example.com
